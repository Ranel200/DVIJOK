# ── Приложение ──────────────────────────────────────────────
APP_NAME="KOMIT CRM API"
ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Публичная точка входа клиентского приложения для реферальных ссылок/QR.
# Корень клиентского SPA; backend добавляет /r/<code> и /book/<code>.
PUBLIC_CLIENT_BASE_URL=https://app.komit.ru/client
SCHEDULE_TIMEZONE=Europe/Moscow
SCHEDULE_SLOT_STEP_MINUTES=30
DEFAULT_APPOINTMENT_DURATION_MINUTES=60
PUBLIC_BOOKING_RATE_LIMIT_ATTEMPTS=10
PUBLIC_BOOKING_RATE_LIMIT_WINDOW_SECONDS=3600
SERVICE_IMPORT_MAX_FILE_BYTES=2097152
SERVICE_IMPORT_MAX_ROWS=2000

# ── База данных (async driver: postgresql+asyncpg) ──────────
DATABASE_URL=postgresql+asyncpg://komit:komit@localhost:5432/komit
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Redis (кэш, локи, очереди уведомлений) ──────────────────
REDIS_URL=redis://localhost:6379/0

# ── Безопасность / JWT ──────────────────────────────────────
# ВАЖНО: в production сгенерировать секрет: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_REFRESH_TOKEN_EXPIRE_DAYS=30
# В production обязательно true; локально false допускает http://localhost.
REFRESH_COOKIE_NAME=dvijok_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# Оставьте пустым для host-only cookie.
REFRESH_COOKIE_DOMAIN=

# ── CORS (домены Admin-панели) ──────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:9000","http://localhost:9001"]

# ── Первичный администратор (для scripts/seed.py) ───────────
FIRST_ADMIN_EMAIL=admin@komit.ru
FIRST_ADMIN_PASSWORD=admin12345
FIRST_ADMIN_NAME=Администратор

# ── Клиентский кабинет / OTP / публичные ссылки ботов ──────
CLIENT_ACCESS_TOKEN_EXPIRE_MINUTES=43200
CLIENT_REFRESH_TOKEN_EXPIRE_DAYS=180
CLIENT_REFRESH_COOKIE_NAME=dvijok_client_refresh
OTP_CODE_LENGTH=4
OTP_CODE_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_IP_RATE_LIMIT_ATTEMPTS=10
OTP_IP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_PEPPER=change-me-in-production-please-min-32-bytes
OTP_PROVIDER=local
# Секрет хранить только в backend environment, не во frontend/Git.
SMS_RU_API_ID=
SMS_RU_CALL_URL=https://sms.ru/code/call
SMS_RU_TIMEOUT_SECONDS=10
# Zvonok.com Flash Call. Секретный ключ хранить только в backend environment.
ZVONOK_PUBLIC_KEY=
ZVONOK_CAMPAIGN_ID=
ZVONOK_FLASHCALL_URL=https://zvonok.com/manager/cabapi_external/api/v1/phones/flashcall/
ZVONOK_TIMEOUT_SECONDS=10
CLIENT_LINK_TOKEN_TTL_SECONDS=600
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=
VK_BOT_TOKEN=
VK_BOT_PUBLIC_URL=
VK_BOT_SECRET=
VK_CONFIRMATION_CODE=
VK_API_VERSION=5.199
MAX_BOT_TOKEN=
MAX_BOT_PUBLIC_URL=
MAX_WEBHOOK_SECRET=
NOTIFICATION_POLL_INTERVAL_SECONDS=2
NOTIFICATION_MAX_ATTEMPTS=5
