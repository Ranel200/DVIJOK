{
  "name": "dvijok-frontend",
  "private": true,
  "type": "module",
  "workspaces": ["admin", "client", "shared", "site"],
  "scripts": {
    "dev": "concurrently -n admin,client,site -c blue,magenta,green \"npm:dev:admin\" \"npm:dev:client\" \"npm:dev:site\"",
    "dev:admin": "npm run dev -w @dvijok/admin",
    "dev:client": "npm run dev -w @dvijok/client",
    "dev:site": "npm run dev -w @dvijok/site",
    "build": "npm run build --workspaces --if-present",
    "build:admin": "npm run build -w @dvijok/admin",
    "build:client": "npm run build -w @dvijok/client",
    "build:site": "npm run build -w @dvijok/site",
    "lint": "npm run lint --workspaces --if-present",
    "lint:check": "npm run lint:check --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
